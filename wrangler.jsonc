{
  "name": "whitecadae",
  "main": "src/index.js",
  "durable_objects": {"bindings":[{"name":"BRAINSTORM_LIVE","class_name":"BrainstormLive"}]},
  "migrations": [{"tag":"v1-brainstorm-live","new_sqlite_classes":["BrainstormLive"]}],
  // Paris Monday midnight is Sunday 22:00 UTC in summer, 23:00 in winter.
  // The idempotent handler uses the Paris week; the other run is harmless.
  "triggers": {"crons":["0 22,23 * * SUN", "*/15 * * * *"]},
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/music/*"]
  },
  // Le relatif des carrés parle par Workers AI. Sans ce binding (ou en local
  // sans accès), l'API répond 503 et le portrait reste copiable : rien ne casse.
  "ai": {
    "binding": "AI",
    // l'IA n'a pas de version locale : le binding vise toujours la ressource
    // distante. En développement local elle reste hors d'atteinte, et tout ce
    // qui l'appelle (le relatif, la transcription des vocaux) répond alors
    // 503 sans rien casser.
    "remote": true
  },
  "stream": {"binding":"STREAM"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whitecadae-db",
      "database_id": "94a4fab8-be1e-41be-8ef1-df5aa32835f3"
    }
  ],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"whitecadae-media"}],
  // Les erreurs du Worker (méthode, route aux identifiants masqués, début du
  // message) sont conservées dans les journaux Cloudflare pour le diagnostic.
  "observability": {"enabled": true},
  "vars": {
    // Aucune adresse déclarée à l'inscription ne confère de droits : les rôles
    // administrateur sont provisionnés en privé, hors de ce fichier.
    "PRIVATE_SPACES_ENABLED": "true"
  }
}
